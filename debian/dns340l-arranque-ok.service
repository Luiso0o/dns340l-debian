# Confirma que el núcleo de Debian arrancado con kexec funciona: borra /boot/dns340l/intento.
# Si ese fichero sigue ahí en el siguiente encendido, el arranque de la flash prueba el núcleo
# anterior o entra en modo rescate (ver initrd/init). Solo se borra si el núcleo en marcha es
# el de /boot/dns340l/version o version.old.
[Unit]
Description=DNS-340L: confirmar arranque con el núcleo de Debian (kexec)
ConditionPathExists=/boot/dns340l/intento
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'V=$$(uname -r); for f in /boot/dns340l/version /boot/dns340l/version.old; do [ "$$V" = "$$(cat $$f 2>/dev/null)" ] && rm -f /boot/dns340l/intento; done; true'

[Install]
WantedBy=multi-user.target
