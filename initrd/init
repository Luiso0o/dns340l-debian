#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Arranque del DNS-340L (initrd grabado en mtd2). Hace de "GRUB": Debian se arranca SIEMPRE con su
# núcleo oficial (linux-image-armmp, actualizable con apt) mediante kexec. El núcleo de la flash solo
# sirve para cargarlo y para el modo rescate.
#  1. Prepara el microcontrolador (DeviceReady, ventilador a media)
#  2. Espera a los discos y ensambla los RAID con mdadm
#  3. Monta el sistema Debian (LABEL=debian-raiz) y salta con kexec al núcleo de /boot/dns340l/
#     (vmlinuz, initrd.img, dtb)
#  4. Si ese núcleo no llegó a arrancar en el intento anterior, prueba el anterior (*.old)
#  5. Si no hay forma de arrancar Debian, entra en MODO RESCATE (/rescate.sh) y dice por qué
#
# Protección: antes del salto se escribe en /boot/dns340l/intento qué núcleo se prueba
# ("actual" o "anterior"); el servicio dns340l-arranque-ok de Debian borra el fichero al arrancar.
# El núcleo de Debian recibe panic=20: si su initramfs falla, el NAS se reinicia solo.
#
# Memoria USB FAT con un fichero RESCATE en la raíz -> modo rescate.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /run
mkdir -p /run/mdadm /tmp /newroot /mnt/usb
USBLOG=""
mdev -s

LOG=/run/arranque.txt
log() { echo "[$(cut -d' ' -f1 /proc/uptime)] $*" | tee -a $LOG > /dev/console; }
# Vuelca a la consola (y al registro) la salida de una orden, con sangría
volcar() { "$@" 2>&1 | sed 's/^/      /' | tee -a $LOG > /dev/console; }
guardar_registro() {
	[ -n "$USBLOG" ] && mount -t vfat "$USBLOG" /mnt/usb 2>/dev/null || return 0
	cp $LOG /mnt/usb/dns340l-arranque.txt; sync; umount /mnt/usb
}
rescate() {
	log "*** $* ***"; log "MODO RESCATE"
	grep -q ' /newroot ' /proc/mounts && umount /newroot
	guardar_registro
	exec /rescate.sh
}

log "Arranque DNS-340L: núcleo $(uname -r)"

# ---------- Microcontrolador ----------
if [ -c /dev/ttyS1 ]; then
	stty -F /dev/ttyS1 115200 cs8 -cstopb -parenb raw -echo 2>/dev/null
	printf '\372\003\001\000\000\000\373' > /dev/ttyS1   # DeviceReady
	sleep 1
	printf '\372\002\000\001\000\000\373' > /dev/ttyS1   # Ventilador a media
fi

# ---------- Esperar a los discos SATA (hasta 20 s) ----------
nsata() { n=0; for b in /sys/block/sd*; do [ -e "$b" ] || continue; readlink -f $b | grep -q /ata && n=$((n+1)); done; echo $n; }
i=0
while [ $i -lt 20 ] && [ "$(nsata)" -lt 4 ]; do sleep 1; i=$((i+1)); mdev -s; done
log "Discos detectados:"
for b in /sys/block/sd*; do
	[ -e "$b" ] || continue
	d=${b##*/}
	if readlink -f $b | grep -q /usb; then tipo=USB; else tipo=SATA; fi
	gb=$(( $(cat $b/size) / 2097152 ))
	log "   /dev/$d  $tipo  ${gb} GiB  $(cat $b/device/model 2>/dev/null | tr -s ' ')"
done
[ "$(nsata)" -ge 4 ] || log "AVISO: solo hay $(nsata) discos SATA (se esperaban 4); se intenta arrancar igualmente"

# ---------- Memorias USB ----------
RESCATE=0
grep -qw rescate /proc/cmdline && RESCATE=1
for d in /dev/sd[a-z]1 /dev/sd[a-z]; do
	[ -b "$d" ] || continue
	readlink -f /sys/class/block/${d##*/} | grep -q /usb || continue
	mount -t vfat -o ro "$d" /mnt/usb 2>/dev/null || continue
	[ -z "$USBLOG" ] && USBLOG=$d
	[ -e /mnt/usb/RESCATE ] && RESCATE=1 && log "Memoria USB $d: fichero RESCATE"
	umount /mnt/usb
done
[ $RESCATE = 1 ] && rescate "Rescate pedido (fichero RESCATE o 'rescate' en la línea de órdenes)"
command -v kexec >/dev/null || rescate "Falta la orden kexec en el arranque de la flash"

# ---------- RAID ----------
log "Ensamblando RAID:"
echo 'DEVICE partitions' > /run/mdadm.conf
volcar mdadm --assemble --scan --config=/run/mdadm.conf
sleep 1; mdev -s
volcar cat /proc/mdstat
grep -q '^md' /proc/mdstat || rescate "No se ha ensamblado ningún RAID"

# ---------- Sistema Debian ----------
ROOT=$(findfs LABEL=debian-raiz 2>/dev/null)
[ -n "$ROOT" ] || rescate "No hay ningún sistema de ficheros con LABEL=debian-raiz"
log "Raíz encontrada: $ROOT"
mount -t ext4 -o ro "$ROOT" /newroot 2>>$LOG || rescate "No se puede montar $ROOT (ext4). Revísalo con e2fsck desde el rescate"
[ -x /newroot/sbin/init ] || [ -L /newroot/sbin/init ] || rescate "En $ROOT no existe /sbin/init: la instalación de Debian está incompleta"

# ---------- Elegir núcleo de Debian ----------
K=/newroot/boot/dns340l
completo() { [ -f $K/vmlinuz$1 ] && [ -f $K/initrd.img$1 ] && [ -f $K/dtb$1 ]; }
INTENTO=$(cat $K/intento 2>/dev/null)
case "$INTENTO" in
	"")
		completo "" || rescate "No hay núcleo de Debian en /boot/dns340l (ejecuta instalar-nucleo-debian.sh)"
		SUF=""; NOMBRE=actual ;;
	actual)
		log "AVISO: el núcleo $(cat $K/version 2>/dev/null) no llegó a arrancar Debian en el intento anterior"
		completo .old || rescate "No hay núcleo anterior (*.old) con el que probar"
		SUF=.old; NOMBRE=anterior ;;
	*)
		rescate "Ni el núcleo actual ni el anterior llegaron a arrancar Debian (fichero /boot/dns340l/intento)" ;;
esac
VER=$(cat $K/version$SUF 2>/dev/null)

# ---------- Salto con kexec ----------
# panic=20: si el initramfs de Debian no encuentra la raíz, reinicia en vez de quedarse parado
ARGS="console=ttyS0,115200 root=LABEL=debian-raiz ro rootwait panic=20 $(cat $K/cmdline 2>/dev/null)"
log "kexec: cargando el núcleo $NOMBRE de Debian ($VER)"
kexec -l $K/vmlinuz$SUF --initrd=$K/initrd.img$SUF --dtb=$K/dtb$SUF --command-line="$ARGS" >>$LOG 2>&1 || \
	rescate "kexec -l no ha podido cargar el núcleo $NOMBRE ($VER); detalle arriba"
mount -o remount,rw /newroot 2>>$LOG || rescate "No se puede montar $ROOT en escritura para anotar el intento"
echo $NOMBRE > $K/intento
mkdir -p /newroot/var/log/dns340l && cp $LOG /newroot/var/log/dns340l/arranque-flash.txt
sync
umount /newroot
mdadm --stop --scan >>$LOG 2>&1
log "kexec: saltando al núcleo $NOMBRE de Debian ($VER)"
# Preparar el hardware para el núcleo nuevo (probado en el DNS-340L, 3-11-2026):
#  1. Encender todos los relojes del SoC: este núcleo apagó los que no usa ("clk: Disabling unused
#     clocks") y el núcleo nuevo se cuelga en silencio si toca un bloque sin reloj. U-Boot los deja
#     encendidos; los bits son los de clock-gating-control del Armada 370 (0xF1018220).
devmem 0xf1018220 32 $(( $(devmem 0xf1018220) | 0x5282823F )) 2>>$LOG || log "AVISO: no se han podido encender los relojes"
#  2. Borrar la copia vieja del árbol de dispositivos que dejó el descompresor de este núcleo: si el
#     descompresor del núcleo nuevo la encuentra pegada a su final, la usa en lugar de la de kexec.
borrar-fdt-viejo SI >>$LOG 2>&1 || log "AVISO: borrar-fdt-viejo ha fallado"
guardar_registro
sync
#  3. kexec -e (sin -x) baja las interfaces de red: mvneta no tiene función de apagado y, si siguen
#     activas, sus DMA escriben paquetes en memoria que ya es del núcleo nuevo.
kexec -e
# Solo se llega aquí si kexec -e falla. El fichero "intento" hará probar el otro núcleo la próxima vez.
rescate "kexec -e ha fallado"
